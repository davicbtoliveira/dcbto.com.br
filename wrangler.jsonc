{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davi-oliveira",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": false,
  "routes": [
    { "pattern": "dcbto.com.br", "custom_domain": true },
    { "pattern": "www.dcbto.com.br", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
